                ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 500)"
              },
              "targetUid": {
                ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 128)"
              },
              "msgSnippet": {
                ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 100)"
              },
              "ts": {
                ".validate": true
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "joins": {
          ".read": true,

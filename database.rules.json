          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "amount": {
          ".validate": "newData.isNumber() && newData.val() >= 20 && newData.val() <= 20000 && newData.val() % 1 === 0"
        },
        "slipUrl": {
          ".validate": "newData.isString() && newData.val().beginsWith('https://res.cloudinary.com/') && newData.val().length <= 500"
        },
        "slipHash": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "status": {
          ".validate": "newData.val() === 'pending' || newData.val() === 'approved' || newData.val() === 'rejected'"
        },
        "ts": {

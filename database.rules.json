{
  "rules": {
    "rooms": {
      "$room": {
        "messages": {
          ".read": true,
          ".indexOn": ["ts"],
          "$msg": {
            ".write": "(!data.exists() && auth != null && newData.child('uid').val() === auth.uid) || (data.exists() && !newData.exists() && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'true'))",
            ".validate": "newData.hasChildren(['uid','name','text','ts']) && newData.child('uid').isString() && newData.child('name').isString() && newData.child('name').val().length <= 40 && newData.child('text').isString() && newData.child('text').val().length >= 1 && newData.child('text').val().length <= 300 && newData.child('ts').val() === now",
            "photo": { ".validate": "newData.isString() && newData.val().length <= 500" },
            "uid":   { ".validate": true },
            "name":  { ".validate": true },
            "text":  { ".validate": true },
            "ts":    { ".validate": true },
            "$other": { ".validate": false }
          }
        },
        "presence": {
          ".read": true,
          "$conn": {
            ".write": "auth != null",
            ".validate": "newData.isBoolean()"
          }
        }
      }
    },
    "settings": {
      ".read": true,
      ".write": "root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'true'"
    },
    "schedule": {
      ".read": true,
      ".write": "root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'true'"
    },
    "admins": {
      ".read": false,
      ".write": false
    }
  }
}

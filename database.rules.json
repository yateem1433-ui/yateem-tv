      ".write": "auth != null && (auth.uid === 'qDOL6lE687ejMumQcpOWtEjAMJ92' || root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'true' || root.child('admins').child(auth.uid).child('role').val() === 'admin')",

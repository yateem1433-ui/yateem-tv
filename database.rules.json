          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && ((auth.uid === 'qDOL6lE687ejMumQcpOWtEjAMJ92' || root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'true' || root.child('admins').child(auth.uid).child('role').val() === 'admin') || (!data.exists() && newData.val() === 0) || (newData.parent().child('lastGiftId').isString() && !root.child('giftFeed').child(newData.parent().child('lastGiftId').val()).exists() && newData.val() === data.val() - newData.parent().parent().parent().child('giftFeed').child(newData.parent().child('lastGiftId').val()).child('amount').val())))"
        },

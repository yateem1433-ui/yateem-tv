      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && ((auth.uid === 'qDOL6lE687ejMumQcpOWtEjAMJ92' || root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'true' || root.child('admins').child(auth.uid).child('role').val() === 'admin') || (auth.uid === $uid && (data.exists() || (newData.child('balance').val() === 0 && !newData.child('credited').exists()))))",

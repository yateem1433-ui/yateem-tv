            ".validate": "!newData.exists() || (newData.hasChildren(['uid','name','e','ts']) && newData.child('uid').isString() && newData.child('name').isString() && newData.child('name').val().length <= 40 && newData.child('e').isString() && newData.child('e').val().length >= 1 && newData.child('e').val().length <= 8 && newData.child('ts').val() === now)",

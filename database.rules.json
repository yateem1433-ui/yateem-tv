{
  "rules": {
    "rooms": {
      "$room": {
        "messages": {
          ".read": true,
          ".indexOn": ["ts"],
          "$msg": {
            ".write": "(!data.exists() && auth != null && newData.child('uid').val() === auth.uid) || (data.exists() && !newData.exists() && auth != null && (auth.uid === 'qDOL6lE687ejMumQcpOWtEjAMJ92' || root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'true'))",
            ".validate": "newData.hasChildren(['uid','name','text','ts']) && newData.child('uid').isString() && newData.child('name').isString() && newData.child('name').val().length <= 40 && newData.child('text').isString() && newData.child('text').val().length >= 1 && newData.child('text').val().length <= 300 && newData.child('ts').val() === now",
            "photo": { ".validate": "newData.isString() && newData.val().length <= 500" },
            "uid":   { ".validate": true },
            "name":  { ".validate": true },
            "text":  { ".validate": true },
            "ts":    { ".validate": true },
            "$other": { ".validate": false }
          }
        },
        "reactions": {
          ".read": true,
          ".indexOn": ["ts"],
          "$r": {
            ".write": "(!data.exists() && auth != null && newData.child('uid').val() === auth.uid) || (data.exists() && !newData.exists() && auth != null && data.child('uid').val() === auth.uid)",
            ".validate": "newData.hasChildren(['uid','name','e','ts']) && newData.child('uid').isString() && newData.child('name').isString() && newData.child('name').val().length <= 40 && newData.child('e').isString() && newData.child('e').val().length >= 1 && newData.child('e').val().length <= 8 && newData.child('ts').val() === now",
            "uid":  { ".validate": true },
            "name": { ".validate": true },
            "e":    { ".validate": true },
            "ts":   { ".validate": true },
            "$other": { ".validate": false }
          }
        },
        "presence": {
          ".read": true,
          "$conn": {
            ".write": "auth != null",
            ".validate": "newData.isBoolean()"
          }
        }
      }
    },
    "settings": {
      ".read": true,
      ".write": "auth != null && (auth.uid === 'qDOL6lE687ejMumQcpOWtEjAMJ92' || root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'true')"
    },
    "schedule": {
      ".read": true,
      ".write": "auth != null && (auth.uid === 'qDOL6lE687ejMumQcpOWtEjAMJ92' || root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'true')"
    },
    "stats": {
      ".read": "auth != null && (auth.uid === 'qDOL6lE687ejMumQcpOWtEjAMJ92' || root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'true')",
      "summary": {
        ".write": "auth != null"
      }
    },
    "giftQueue": {
      ".read": "auth != null && (auth.uid === 'qDOL6lE687ejMumQcpOWtEjAMJ92' || root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'true')",
      ".indexOn": ["status", "slipHash", "ts"],
      "$id": {
        ".read": "auth != null && data.child('uid').val() === auth.uid",
        ".write": "(!data.exists() && auth != null && newData.child('uid').val() === auth.uid && newData.child('status').val() === 'pending') || (auth != null && (auth.uid === 'qDOL6lE687ejMumQcpOWtEjAMJ92' || root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'true'))",
        ".validate": "newData.hasChildren(['uid','name','giftId','amount','slipUrl','status','ts']) && (data.exists() || newData.child('ts').val() === now)",
        "uid":       { ".validate": "newData.isString() && newData.val().length <= 128" },
        "name":      { ".validate": "newData.isString() && newData.val().length <= 40" },
        "anon":      { ".validate": "newData.isBoolean()" },
        "giftId":    { ".validate": "newData.isString() && newData.val().length <= 20" },
        "amount":    { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100000" },
        "slipUrl":   { ".validate": "newData.isString() && newData.val().beginsWith('https://res.cloudinary.com/') && newData.val().length <= 500" },
        "slipHash":  { ".validate": "newData.isString() && newData.val().length <= 80" },
        "status":    { ".validate": "newData.val() === 'pending' || newData.val() === 'approved' || newData.val() === 'rejected'" },
        "ts":        { ".validate": "newData.isNumber()" },
        "decidedAt": { ".validate": "newData.isNumber()" },
        "$other":    { ".validate": false }
      }
    },
    "giftFeed": {
      ".read": true,
      ".indexOn": ["ts"],
      "$id": {
        ".write": "auth != null && (auth.uid === 'qDOL6lE687ejMumQcpOWtEjAMJ92' || root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'true')",
        ".validate": "newData.hasChildren(['name','giftId','amount','ts'])"
      }
    },
    "kitchen": {
      ".read": true,
      ".write": false
    },
    "admins": {
      ".read": false,
      ".write": false
    }
  }
}

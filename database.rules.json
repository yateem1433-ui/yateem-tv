          "$msg": {
            ".write": "auth != null && ((auth.uid === 'qDOL6lE687ejMumQcpOWtEjAMJ92' || root.child('admins').child(auth.uid).exists()) || (!newData.exists() && !root.child('rooms').child($room).child('messages').child($msg).exists()))",

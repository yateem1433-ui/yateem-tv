        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (!newData.exists() && (auth.uid === 'qDOL6lE687ejMumQcpOWtEjAMJ92' || root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'true' || root.child('admins').child(auth.uid).child('role').val() === 'admin')))",
        ".validate": "!newData.exists() || (newData.hasChildren(['uid','name','giftId','amount','ts']) && newData.child('ts').val() === now && newData.child('giftId').isString() && newData.child('amount').isNumber() && root.child('giftPrices').child(newData.child('giftId').val()).val() === newData.child('amount').val() && newData.parent().parent().child('wallets').child(auth.uid).child('lastGiftId').val() === $id && newData.parent().parent().child('wallets').child(auth.uid).child('balance').val() === root.child('wallets').child(auth.uid).child('balance').val() - newData.child('amount').val())",
        "uid": {
          ".validate": "newData.isString()"
        },
